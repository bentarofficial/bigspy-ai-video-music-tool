# Lấy miễn phí: đăng nhập Pixabay, mở https://pixabay.com/api/docs/#api_search_videos -> dòng "key (required)" -> "Your API key"
PIXABAY_API_KEY=
# Nếu ổ cài app gần đầy, đặt thư mục dữ liệu trên ổ còn chỗ (vd: D:\AI-Music-Video-Data).
# Chép output/, uploads/, exports/, .cache/ và remotion/public/ cũ sang thư mục mới trước khi mở lại app.
# AI_MUSIC_VIDEO_DATA_DIR=D:\AI-Music-Video-Data
# Chọn cảnh theo lời bài hát dùng Claude CLI (lệnh `claude`) với gói đang đăng nhập — không cần API key.
# Mặc định khi chạy dòng lệnh (trong giao diện web chọn trực tiếp):
#   claude-haiku-5-5 (Haiku 5.5) / claude-sonnet-5-5 (Sonnet 5.5) / claude-opus-5-5 (Opus 5.5) / claude-fable-5-2 (Fable 5.2)
# MV_CLAUDE_MODEL=claude-haiku-5-5
# Mức suy nghĩ: low / medium / high / xhigh / max (bỏ trống = mặc định của model)
# MV_CLAUDE_EFFORT=
